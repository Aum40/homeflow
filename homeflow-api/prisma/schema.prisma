generator client {
  provider     = "prisma-client"
  output       = "../src/database/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  PROJECT_MANAGER
  CUSTOMER
}

enum ProjectStatus {
  REQUESTED
  PLANNING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  password  String
  role      UserRole @default(CUSTOMER)
  isActive  Boolean  @default(true) @map("is_active")
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  nickName  String?  @map("nick_name")
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  customerProjects        Project[]              @relation("customerProjects")
  managedProjects         Project[]              @relation("projectManagerProjects")
  materialWithdrawals     MaterialWithdrawal[]
  completedChecklistItems ProjectChecklistItem[]
  passwordResetTokens     PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  usedAt    DateTime? @map("used_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Project {
  id               String        @id @default(uuid()) @db.Uuid
  customerId       String        @map("customer_id") @db.Uuid
  projectManagerId String?       @map("project_manager_id") @db.Uuid
  houseDesignId    String?       @map("house_design_id") @db.Uuid
  projectName      String        @map("project_name")
  imageUrl         String?       @map("image_url")
  houseType        String        @map("house_type")
  location         String
  latitude         Decimal?      @db.Decimal(9, 6)
  longitude        Decimal?      @db.Decimal(9, 6)
  estimatedBudget  Decimal       @map("estimated_budget") @db.Decimal(14, 2)
  actualCost       Decimal       @default(0) @map("actual_cost") @db.Decimal(14, 2)
  status           ProjectStatus @default(REQUESTED)
  description      String?
  startDate        DateTime?     @map("start_date") @db.Date
  endDate          DateTime?     @map("end_date") @db.Date
  completedAt      DateTime?     @map("completed_at") @db.Timestamptz()
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  customer       User                   @relation("customerProjects", fields: [customerId], references: [id])
  projectManager User?                  @relation("projectManagerProjects", fields: [projectManagerId], references: [id])
  houseDesign    HouseDesign?           @relation(fields: [houseDesignId], references: [id], onDelete: Restrict)
  materials      ProjectMaterial[]
  checklistItems ProjectChecklistItem[]

  @@map("projects")
}

model HouseDesign {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  imageUrl    String?  @map("image_url")
  basePrice   Decimal  @map("base_price") @db.Decimal(14, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  projects Project[]
  steps    HouseDesignStep[]

  @@map("house_designs")
}

model HouseDesignStep {
  id            String   @id @default(uuid()) @db.Uuid
  houseDesignId String   @map("house_design_id") @db.Uuid
  title         String
  order         Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  houseDesign HouseDesign @relation(fields: [houseDesignId], references: [id], onDelete: Cascade)

  @@map("house_design_steps")
}

/// ข้อมูลติดต่อบริษัท มีแถวเดียวเสมอ — isSingleton @unique ทำให้ upsert เป็น atomic
model CompanyContact {
  id            String   @id @default(uuid()) @db.Uuid
  isSingleton   Boolean  @unique @default(true) @map("is_singleton")
  companyName   String?  @map("company_name")
  address       String?
  phone         String?
  email         String?
  latitude      Decimal? @db.Decimal(9, 6)
  longitude     Decimal? @db.Decimal(9, 6)
  businessHours String?  @map("business_hours")
  lineId        String?  @map("line_id")
  facebook      String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("company_contacts")
}

model Material {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  category  String
  unit      String
  price     Decimal  @db.Decimal(12, 2)
  stock     Int      @default(0)
  imageUrl  String?  @map("image_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  projectMaterials ProjectMaterial[]

  @@map("materials")
}

model ProjectMaterial {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  materialId String   @map("material_id") @db.Uuid
  usedQty    Int      @default(0) @map("used_qty")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  project     Project              @relation(fields: [projectId], references: [id])
  material    Material             @relation(fields: [materialId], references: [id])
  withdrawals MaterialWithdrawal[]

  @@unique([projectId, materialId])
  @@map("project_materials")
}

model MaterialWithdrawal {
  id                String   @id @default(uuid()) @db.Uuid
  projectMaterialId String   @map("project_material_id") @db.Uuid
  qty               Int
  unitPriceAtTime   Decimal  @map("unit_price_at_time") @db.Decimal(12, 2)
  withdrawnById     String   @map("withdrawn_by_id") @db.Uuid
  withdrawnAt       DateTime @default(now()) @map("withdrawn_at") @db.Timestamptz()

  projectMaterial ProjectMaterial @relation(fields: [projectMaterialId], references: [id])
  withdrawnBy     User            @relation(fields: [withdrawnById], references: [id])

  @@map("material_withdrawals")
}

model ProjectChecklistItem {
  id            String    @id @default(uuid()) @db.Uuid
  projectId     String    @map("project_id") @db.Uuid
  title         String
  order         Int       @default(0)
  isCompleted   Boolean   @default(false) @map("is_completed")
  completedAt   DateTime? @map("completed_at") @db.Timestamptz()
  completedById String?   @map("completed_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  project     Project                     @relation(fields: [projectId], references: [id])
  completedBy User?                       @relation(fields: [completedById], references: [id])
  photos      ProjectChecklistItemPhoto[]

  @@map("project_checklist_items")
}

model ProjectChecklistItemPhoto {
  id              String   @id @default(uuid()) @db.Uuid
  checklistItemId String   @map("checklist_item_id") @db.Uuid
  imageUrl        String   @map("image_url")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()

  checklistItem ProjectChecklistItem @relation(fields: [checklistItemId], references: [id])

  @@map("project_checklist_item_photos")
}
